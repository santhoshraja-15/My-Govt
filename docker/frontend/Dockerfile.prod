# Production image for the Next.js app (standalone output). Build context: ./frontend
#   docker build -f docker/frontend/Dockerfile.prod --build-arg NEXT_PUBLIC_API_URL=https://api.example.org -t mygovt-frontend frontend
# NOT yet built or run anywhere (no Docker on the author's machine).
FROM node:22-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

FROM node:22-alpine AS build
WORKDIR /app
ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL NEXT_PUBLIC_APP_ENV=production NEXT_TELEMETRY_DISABLED=1
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npm run build

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000 HOSTNAME=0.0.0.0
RUN addgroup -S -g 10001 mygovt && adduser -S -u 10001 -G mygovt mygovt
COPY --from=build --chown=mygovt:mygovt /app/.next/standalone ./
COPY --from=build --chown=mygovt:mygovt /app/.next/static ./.next/static
USER mygovt
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD wget -qO- http://127.0.0.1:3000/ >/dev/null || exit 1
CMD ["node", "server.js"]
