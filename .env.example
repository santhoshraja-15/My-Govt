# ================================================================
# MyGovt — Environment Configuration Template
# Copy to .env and fill in your values. NEVER commit .env to git.
# ================================================================

# --- PostgreSQL -----------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=mygovt
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_postgres

# Application DB roles (created by init script)
MYGOVT_APP_PASSWORD=change_me_app
MYGOVT_AI_READONLY_PASSWORD=change_me_ai
MYGOVT_ETL_PASSWORD=change_me_etl
MYGOVT_ADMIN_PASSWORD=change_me_admin

# --- Neo4j ---------------------------------------------------
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me_neo4j
NEO4J_AUTH=neo4j/change_me_neo4j

# --- Redis ---------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- MinIO ---------------------------------------------------
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change_me_minio
MINIO_BUCKET_EVIDENCE=mygovt-evidence
MINIO_BUCKET_DOCUMENTS=mygovt-documents

# --- JWT / Auth ----------------------------------------------
JWT_SECRET_KEY=change_me_very_long_random_secret_at_least_64_chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- LLM Provider -------------------------------------------
# Options: openai | google | anthropic | local | none
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.1

# --- Embedding -----------------------------------------------
# Options: local | openai | none
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=32

# --- AI Pipeline Config --------------------------------------
TRUST_THRESHOLD=0.70
CLASSIFIER_CONFIDENCE_THRESHOLD=0.60
HYBRID_WEIGHT_SEMANTIC=0.35
HYBRID_WEIGHT_KEYWORD=0.25
HYBRID_WEIGHT_GRAPH=0.15
HYBRID_WEIGHT_RELIABILITY=0.15
HYBRID_WEIGHT_FRESHNESS=0.10
MAX_RETRIEVAL_CHUNKS=50
MAX_CONTEXT_TOKENS=6000

# --- Application ---------------------------------------------
APP_ENV=development
APP_LOG_LEVEL=INFO
APP_CORS_ORIGINS=http://localhost:3000
APP_DEBUG=true
BACKEND_URL=http://backend:8000
FRONTEND_URL=http://localhost:3000

# --- Feature Flags -------------------------------------------
FEATURE_VOICE=false
FEATURE_GRAPH=true
FEATURE_VECTOR_SEARCH=true
FEATURE_DOCUMENT_PREVIEW=true

# --- STT/TTS (optional) -------------------------------------
STT_PROVIDER=none
TTS_PROVIDER=none
STT_API_KEY=
TTS_API_KEY=
